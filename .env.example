PORT=3000
PUBLIC_BASE_URL=http://localhost:3000

# Local Ollama. Pull the model first: ollama pull gemma2:2b
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma2:2b
OLLAMA_TIMEOUT_MS=120000

# ElevenLabs text-to-speech. Never commit the real key.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_TIMEOUT_MS=60000

# MongoDB Atlas connection string
MONGODB_URI=
MONGODB_DB_NAME=memoryquest

# Optional. Tracing is a no-op when this is empty.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=1.0

UPLOAD_DIR=uploads
